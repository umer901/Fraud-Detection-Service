# demo = deterministic, no API calls. groq = live LLM on Groq's rate-limited free plan.
# Create a key at https://console.groq.com/keys and switch the mode to groq.
INVESTIGATION_MODE=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_PATH=data/fraud.db
INVESTIGATION_TIMEOUT_SECONDS=90
MAX_AGENT_ROUNDS=6
MAX_TOOL_CALLS=12
